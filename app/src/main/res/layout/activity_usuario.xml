<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DE USUARIOS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:padding="16dp"
            android:background="#7266E8"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtIdUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID Usuario"
            android:inputType="number"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edtNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre y Apellido"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edtContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edtRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rol"
            android:inputType="text"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnRegistrarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRAR USUARIO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7266E8"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBuscarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUSCAR USUARIO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7266E8"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnActualizarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTUALIZAR USUARIO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7266E8"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEliminarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELIMINAR USUARIO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7266E8" />

    </LinearLayout>

</ScrollView>